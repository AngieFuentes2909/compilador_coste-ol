x Entero;
y Entero;
suma Entero;
resta Entero;
producto Entero;
division Real;

x = 20;
y = 4;

suma = x + y;
resta = x - y;
producto = x * y;
division = x - y;

Mensaje.Texto("Valores: x = 20, y = 4");
