nombre Texto;
edad Entero;

Mensaje.Texto("¡Epa! ¿Cómo te llamas, llave?");
nombre = Captura.Texto();

Mensaje.Texto("¿Y cuántos años tienes, mi llave?");
edad = Captura.Entero();

Mensaje.Texto("¡Qué nota! Te llamas:");
Mensaje.Texto(nombre);
Mensaje.Texto("Y tienes:");
Mensaje.Texto(edad);
